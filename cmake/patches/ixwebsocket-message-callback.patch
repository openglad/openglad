@@ -455,0 +457,11 @@ namespace ix
+    void WebSocket::invokeOnMessageCallback(const WebSocketMessagePtr& message)
+    {
+        OnMessageCallback callback;
+        {
+            std::lock_guard<std::mutex> lock(_configMutex);
+            callback = _onMessageCallback;
+        }
+        // Invoke outside the lock: callbacks may replace themselves or read config.
+        if (callback) callback(message);
+    }
+
@@ -458 +470,13 @@ namespace ix
-        _onMessageCallback = callback;
+        OnMessageCallback replacement;
+        if (callback)
+        {
+            // Copies of the dispatch wrapper share the registered callable, so
+            // mutable captures retain their state and an in-flight call owns it.
+            auto target = std::make_shared<OnMessageCallback>(callback);
+            replacement = [target](const WebSocketMessagePtr& message) { (*target)(message); };
+        }
+        {
+            std::lock_guard<std::mutex> lock(_configMutex);
+            _onMessageCallback.swap(replacement);
+        }
+        // Destroy the old target after unlocking; its captures may reenter us.
