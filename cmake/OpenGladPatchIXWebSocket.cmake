if(NOT DEFINED OPENGLAD_IXWEBSOCKET_SOURCE_DIR)
    message(FATAL_ERROR "OPENGLAD_IXWEBSOCKET_SOURCE_DIR is required")
endif()
find_package(Git REQUIRED)
set(OG_IX_SAFETY_PATCH "${CMAKE_CURRENT_LIST_DIR}/patches/ixwebsocket-safety.patch")
execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unidiff-zero --reverse --check "${OG_IX_SAFETY_PATCH}"
    WORKING_DIRECTORY "${OPENGLAD_IXWEBSOCKET_SOURCE_DIR}"
    RESULT_VARIABLE OG_IX_SAFETY_ALREADY_PATCHED OUTPUT_QUIET ERROR_QUIET)
if(NOT OG_IX_SAFETY_ALREADY_PATCHED EQUAL 0)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unidiff-zero "${OG_IX_SAFETY_PATCH}"
        WORKING_DIRECTORY "${OPENGLAD_IXWEBSOCKET_SOURCE_DIR}"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
