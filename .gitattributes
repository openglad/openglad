# Keep vendored libraries, generated artifacts, and bulk asset data out of the
# GitHub diff and language stats so reviews focus on hand-written code. These
# files are still tracked and built normally; linguist-vendored / -generated
# only collapse them in PR diffs (reviewers can expand) and exclude them from the
# language bar and the diffstat.

# Vendored upstream libraries (PhysFS, zlib, libzip, libyaml, yam, micropather,
# IXWebSocket, LodePNG). Not OpenGlad source — see third_party/VENDORED_LIBS.md.
third_party/** linguist-vendored

# Generated / regenerable parity-harness fixtures (emitted by scripts/parity/).
tests/parity/scenario_facts_generated.json linguist-generated
tests/parity/scenario_table.h             linguist-generated

# Package-manager lockfiles (root + relay/) — generated by npm.
package-lock.json linguist-generated

# Sprite metadata emitted alongside the PNG assets (data, not source code).
pix/*.json linguist-generated
