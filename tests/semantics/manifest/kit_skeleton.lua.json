      "function": "ticks_mana_buys",
      "anchor": "if phase == 0 then",
      "condition": "phase == 0",
      "semantic": "A mana-drained marker's clock (DIG IN burrow, REASSEMBLE ward) is clamped to the tick the mana actually runs out, so the countdown shown is the real end: pulses the pool can still pay plus the ticks to the next pulse (a full pulse right after one).",
      "arms": [
        {
          "when": "left on a pulse boundary (phase 0)",
          "observable": "clock clamps to floor(mp/drain)*pulse + pulse"
        },
        {
          "when": "mid-pulse",
          "observable": "clock clamps to floor(mp/drain)*pulse + (left mod pulse)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
