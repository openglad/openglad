      "function": "facing_of",
      "anchor": "if dir >= 0 then",
      "condition": "dir >= 0 / dir < 8 ; fx == 0 / fy == 0",
      "semantic": "BONE WALL rises across the skeleton's facing: its 8-way curdir when it has one, else the signs of its last heading, else straight up.",
      "arms": [
        {
          "when": "curdir 0..7",
          "observable": "wall centre = skeleton centre + FACING step * wall_gap; segments laid perpendicular (e.g. FACE_UP_RIGHT gives segments at (99,58),(115,74),(131,90))"
        },
        {
          "when": "curdir sentinel, last heading non-zero",
          "observable": "wall placed along sign(lastx),sign(lasty) (lastx<0 -> segments at x 75)"
        },
        {
          "when": "curdir sentinel, lastx=lasty=0",
          "observable": "wall placed straight up (segments at y 74)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
          "test": "KitSkeleton.bone_wall_follows_the_facing"
        }
      ],
      "missing_arms": []
    },
