  "rules": [
    {
      "id": "living-08-slime.lua:23",
      "lines": [
        23
      ],
      "function": "calculate_level",
      "anchor": "while acc <= experience do",
      "condition": "while acc <= experience do",
      "semantic": "A slime character's level after a high-experience split is the highest level whose cumulative experience requirement (sum over k=2..L of 8000+2000(k-1)+4000(k-2), uint32) does not exceed the experience held; level 1 below 8000.",
      "arms": [
        {
          "when": "exp < 8000",
          "observable": "level 1"
        },
        {
          "when": "exp in [8000,18000)",
          "observable": "level 2"
        },
        {
          "when": "exp=30000 (calc_exp(3)=18000 <= 30000 < calc_exp(4)=34000)",
          "observable": "level 3"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_pack_lua_paths.cpp",
          "test": "PackLuaSlime.a_veteran_split_halves_the_experience_across_both_bodies",
          "note": "level 3 at 30000 exp"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "living-08-slime.lua:43",
      "lines": [
        43
      ],
      "function": "slime_check_special_ai",
      "anchor": "return og.living_count() < C.MAXOBS",
      "condition": "return og.living_count() < C.MAXOBS",
      "semantic": "A big slime bot only SPLITs while the world's head-count is under MAXOBS (room for the extra body); small and medium slimes have no AI gate (GROW is always rolled).",
      "arms": [
        {
          "when": "living_count < MAXOBS",
          "observable": "gate true; AI split happens"
        },
        {
          "when": "living_count >= MAXOBS",
          "observable": "gate false; no split"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "parity": "ai_slime_split_scen99",
          "fact": "WalkerFamilyCount(FAMILY_SLIME,0,0)+WalkerFamilyCount(FAMILY_SMALL_SLIME,2,2) (true arm)"
        },
        {
          "file": "tests/integration/test_family_behaviors.cpp",
          "test": "FamilyBehaviors.check_special_slime_capacity",
          "note": "true arm only"
        }
      ],
      "missing_arms": []
    },
