      "function": "grow_into",
      "anchor": "if self:spaces_clear() > 7 then",
      "condition": "if self:spaces_clear() > 7 then ... else",
      "semantic": "A small or medium slime GROWs into the next size only when all eight neighbouring probe boxes are free; otherwise the cast fails with NO ROOM TO GROW and the slime wanders 10 steps in a random direction (two og.rand(3) draws, y first).",
      "arms": [
        {
          "when": "all 8 probes clear",
