      "function": "slime_on_ani_complete",
      "anchor": "if child:has_guy() and child:g_exp() < exp_needed then",
      "condition": "if child:has_guy() and child:g_exp() < exp_needed ... elseif child:has_guy()",
      "semantic": "A hired slime that splits can only sustain a second character if it holds at least 1000 x level experience: below that the sibling is stripped to a plain monster named SLIME at level calculate_level(exp/2); at or above it both halves keep a character, each levelled to calculate_level(exp/2) holding exp/2.",
      "arms": [
        {
          "when": "monster slime (no guy)",
          "observable": "neither arm: sibling just copies stats"
        },
        {
          "when": "guy, exp < 1000*level",
          "observable": "sibling myguy == nullptr, name 'SLIME', parent keeps its character"
        },
        {
          "when": "guy, exp >= 1000*level",
          "observable": "both myguy exp == exp/2, both myguy level == calculate_level(exp/2)"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
