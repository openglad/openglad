      "function": "m_set_kit_state",
      "anchor": "if (hide != w->hidden())",
      "condition": "hide != w->hidden() ; w->hidden() ? KIT_HIDDEN : 0",
      "semantic": "A kit setting its state bits from Lua goes through the real hide rule: flipping the HIDDEN bit hides/unhides the walker (it leaves/rejoins the collision table), and a possessed body can never be hidden, so the HIDDEN bit lands only as set_hidden allowed; the other bits land as asked (narrowed to a byte).",
      "arms": [
        {
          "when": "HIDDEN requested, walker free",
          "observable": "hidden()==true, kit_state has HIDDEN, walker out of obmap"
        },
        {
          "when": "HIDDEN requested, walker possessed",
          "observable": "hidden()==false, kit_state lacks HIDDEN but keeps the other bits, still in obmap"
        },
        {
          "when": "HIDDEN cleared",
          "observable": "hidden()==false, back in obmap"
        },
        {
          "when": "HIDDEN unchanged",
          "observable": "no set_hidden call, other bits replaced"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_specials_view.cpp",
          "test": "KitLuaTest.kit_state_bindings_read_and_write_the_walker",
          "note": "HIDDEN requested free: hidden, kit_state 3, out of obmap; HIDDEN cleared: set_kit_state(0) reveals, back in obmap"
        },
        {
          "file": "tests/unit/test_specials_view.cpp",
          "test": "KitLuaTest.set_kit_state_cannot_hide_a_possessed_body",
          "note": "possessed: not hidden, kit_state == KIT_FEARLESS, still in obmap; then free: hidden + both bits"
        },
        {
          "file": "tests/unit/test_sem_script_2.cpp",
          "test": "SemKitBindings.set_kit_state_with_hidden_unchanged_replaces_the_other_bits"
        }
      ],
      "missing_arms": []
    },
