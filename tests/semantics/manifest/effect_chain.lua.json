      "function": "on_act (core:chain)",
      "anchor": "if foe_count ~= 0 and fork_damage > t.fork_min_damage then",
      "condition": "foe_count ~= 0 and fork_damage > t.fork_min_damage",
      "semantic": "A struck bolt forks only when there is a foe in reach and its children would carry more than 20 damage (half its own, truncated): weak bolts end the chain. The fork budget draws one RNG only when forking.",
      "arms": [
        {
          "when": "foes in reach and trunc(damage*0.5) > 20",
          "observable": "rand0(owner level)+1 drawn; child bolts of damage trunc(damage/2)",
          "asserted": true
        },
        {
          "when": "no foe in reach",
          "observable": "no draw, no child",
          "asserted": true
        },
        {
          "when": "child damage <= 20 (bolt damage <= 41)",
          "observable": "no draw, no child",
          "asserted": false
        }
      ],
      "setting": "none",
      "status": "executed-only",
      "tests": [
        {
          "file": "tests/integration/test_effect_chain_and_door.cpp",
          "test": "EffectChainAndDoor.effect_chain_hits_leader_spawns_explosion_and_secondary_chains_and_door_open_spawns_fx",
          "note": "forking arm: exactly one FAMILY_CHAIN child, damage 50.0 = trunc(100*0.5), leader foe2"
        },
        {
          "file": "tests/integration/test_effect_more_paths.cpp",
