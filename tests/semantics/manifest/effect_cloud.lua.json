      "function": "on_act (core:cloud)",
      "anchor": "if self:lifetime() > 0 then",
      "condition": "self:lifetime() > 0 / else",
      "semantic": "A poison cloud ages one tick per act and vanishes on the act after its lifetime reaches 0 (without acting further that tick).",
      "arms": [
        {
          "when": "lifetime > 0",
          "observable": "lifetime -1, cloud acts (damage + drift)"
        },
        {
          "when": "lifetime <= 0",
          "observable": "dead == 1, no damage or drift that tick, lifetime unchanged"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
