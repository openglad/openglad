      "function": "M.siphon",
      "anchor": "if phased(self) then",
      "condition": "phased ; is_busy ; not foe ; heal > 0",
      "semantic": "SIPHON touches the nearest living foe within siphon_reach with its own damage and heals the ghost half the damage dealt (truncated, never past max). A touch that finds a foe costs one attack pause (busy += fire_frequency), even when it deals 0; an empty touch spends the mana but adds NO pause (it returns before set_busy). A phased or busy ghost refuses.",
      "arms": [
        {
          "when": "phased",
          "observable": "false, 'PHASED'"
        },
        {
          "when": "busy",
          "observable": "false, 'SPECIAL BUSY'"
        },
        {
          "when": "no foe within siphon_reach",
          "observable": "true, MP spent, notification \"<name>'s touch finds nothing\", busy unchanged (0)"
        },
        {
          "when": "foe touched, dealt d > 1",
          "observable": "ghost hp += trunc(d/2) clamped to max, foe hp -= d, busy += fire_frequency"
        },
        {
          "when": "foe touched, dealt 0 or 1 (resisted)",
          "observable": "no heal, MP spent, busy += fire_frequency even when dealt 0"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_ghost.cpp",
          "test": "KitGhost.siphon_heals_half_of_damage_dealt_never_above_max"
        },
        {
          "file": "tests/unit/test_kit_ghost.cpp",
          "test": "KitGhost.empty_siphon_still_spends",
          "note": "empty touch: EXPECT_FLOAT_EQ(0.0f, ghost->busy()); resisted touch: busy == fire_frequency"
        },
        {
