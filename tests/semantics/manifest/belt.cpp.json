          "when": "well-formed (slot 1..5, bits 4-7 clear)",
          "observable": "Entry{slot, alt} returned; decode_stored/validate_cast accept it"
        },
        {
          "when": "slot 0,6,7 or item bit or bits 4-6 set",
          "observable": "nullopt; validate_cast -> Refusal::NothingThere"
        }
      ],
      "setting": "none",
      "status": "asserted",
