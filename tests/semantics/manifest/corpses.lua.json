      "function": "body_for",
      "anchor": "if body ~= nil then",
      "condition": "body ~= nil / self:is_friendly(blood)",
      "semantic": "With Gameplay Fixes on, the room a raise needs is measured for the body that will actually rise: RAISE SKELETON / RAISE GHOST probe their own family; RESURRECT probes the corpse's old family when the stain is friendly and a ghost when it is a foe's.",
      "arms": [
        {
          "when": "body given (raise skeleton/ghost)",
          "observable": "the probed family is the given one (a ghost-sized gap suffices for RAISE GHOST)"
        },
        {
          "when": "RESURRECT on a friendly stain",
          "observable": "probed family = blood:s_old_family(); a risen body of that family"
        },
        {
          "when": "RESURRECT on a foe stain",
          "observable": "probed family = core:ghost"
        }
      ],
      "setting": "fixes-on",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_cleric_unit.cpp",
          "test": "GameplayFixesClericRaise.resurrect_takes_the_nearest_usable_stain_whatever_its_team"
        },
        {
          "file": "tests/unit/test_pack_lua_paths.cpp",
          "test": "PackLuaCleric.resurrecting_a_friendly_corpse_restores_its_family"
        }
      ],
      "missing_arms": []
    },
