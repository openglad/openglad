      "semantic": "When the reel step would bring the foe against the captain (his box grown 2 px) the foe is set down on the clear ring spot beside him, but only if that spot is no further than one reel step from where the foe is; otherwise (or with no ring spot) the foe stays put; either way the reel ends.",
      "arms": [
        {
          "when": "ring spot within one step",
          "observable": "foe:setxy(ring spot); blade centred on the foe; blade dead"
        },
        {
          "when": "ring spot farther than a step",
          "observable": "foe not moved; blade dead"
        },
        {
          "when": "no ring spot",
          "observable": "foe not moved; blade dead"
        },
        {
          "when": "not yet at feet",
          "observable": "normal step (effect_hook_blade.lua:105)"
        }
