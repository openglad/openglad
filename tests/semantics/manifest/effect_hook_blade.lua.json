      ],
      "kinds": [
        "if"
      ],
      "function": "hook_radius",
      "anchor": "if age <= turn then",
      "condition": "age <= turn",
      "semantic": "The captain's HOOK BLADE spirals out 2 px a tick from 12 px to 60 px over 24 ticks, then back in at the same pace to 12 px at tick 48.",
      "arms": [
        {
          "when": "age <= 24",
          "observable": "radius = 12 + 2*age"
        },
        {
          "when": "age > 24",
          "observable": "radius = 60 - 2*(age-24)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.hook_spirals_out_and_back",
          "note": "worldx/worldy every tick 1..48 against hook_offset_at, widest 60"
        }
      ],
      "missing_arms": []
    },
