      "anchor": "if self:leader() then",
      "condition": "self:leader() (set by kit_captain when its own captain plants a new banner)",
      "semantic": "A banner struck by its captain planting a new one comes down quietly (a flash only); a banner chopped down by foes or worn out falls loudly: explosion sound and 'The banner falls.'.",
      "arms": [
        {
          "when": "leader set (replaced by new banner)",
          "observable": "one flash fx where it stood; 0 SOUND_EXPLODE; no 'The banner falls.' notification"
        },
        {
          "when": "no leader (chopped / expired)",
          "observable": "flash fx, 1 SOUND_EXPLODE, notification 'The banner falls.'"
        }
      ],
