{
  "path": "packs/core/lib/weapon_banner.lua",
  "rules": [
    {
      "id": "weapon_banner.lua:15",
      "lines": [
        15
      ],
      "function": "pulse (on_animate)",
      "anchor": "if w:floor() == self:floor() then",
      "condition": "w:floor() == self:floor()",
      "semantic": "On each banner pulse every ally (any living family, captain included) within banner_radius on the banner's own floor heals banner_regen, capped at max hp; an ally on another floor at the same x/y gets nothing.",
      "arms": [
        {
          "when": "ally in radius, same floor",
          "observable": "ally hp += banner_regen (clamped to max)"
        },
        {
          "when": "ally in radius, other floor",
          "observable": "ally hp unchanged"
        },
        {
          "when": "ally out of radius",
          "observable": "ally hp unchanged"
        }
      ],
      "setting": "new-specials",
      "status": "executed-only",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.banner_regens_allies_and_frights_lower_foes",
          "note": "same-floor and out-of-radius arms asserted; other-floor arm not"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "weapon_banner.lua:24",
      "lines": [
        22,
        23,
        24
      ],
      "function": "pulse (on_animate)",
      "anchor": "local living = w:order() == C.ORDER_LIVING",
      "condition": "w:order() == ORDER_LIVING and w.level < self.level",
      "semantic": "On each pulse every LIVING foe within banner_radius whose level is below the banner's is frightened away from it (fright walk pointing away on each axis); a foe of the banner's level or higher, a generator, or a fearless (rallied) foe holds its ground.",
      "arms": [
        {
          "when": "living foe, level < banner level, not fearless",
          "observable": "foe gets a fright command; com1 = sign(foe.x - banner.x), com2 = sign(foe.y - banner.y)"
        },
        {
          "when": "living foe, level >= banner level",
          "observable": "no command queued"
        },
        {
          "when": "generator foe",
          "observable": "no fright (order gate)"
        },
        {
          "when": "fearless foe (inside its own banner's rally_radius)",
          "observable": "no command (s_force_fright skips via og::sim::fearless)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.banner_regens_allies_and_frights_lower_foes",
          "note": "weaker frightened east, stronger holds"
        },
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.rallied_walker_does_not_flee_when_hit",
          "note": "fearless"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "weapon_banner.lua:39",
      "lines": [
        39
      ],
      "function": "on_animate",
      "anchor": "if og.mod(og.world_tick(), t.banner_pulse) == 0 then",
      "condition": "og.mod(og.world_tick(), t.banner_pulse) == 0",
      "semantic": "A banner's aura pulses only on world ticks that are multiples of banner_pulse (8); between pulses it heals and frightens nothing, but it still counts down its lifetime every tick.",
      "arms": [
        {
          "when": "tick % banner_pulse == 0",
          "observable": "heal/fright applied (see :15, :24)"
        },
        {
          "when": "otherwise",
          "observable": "ally hp unchanged, no fright command; lifetime still -1"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.banner_regens_allies_and_frights_lower_foes",
          "note": "tick 801 nothing, tick 808 pulse"
        }
      ],
      "missing_arms": []
    },
