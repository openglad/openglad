      "id": "weapon_banner.lua:43",
      "lines": [
        43
      ],
      "function": "on_animate",
      "anchor": "if lifetime < 1 then",
      "condition": "lifetime < 1 (read before decrement)",
      "semantic": "A war banner stands for its lifetime and then falls by itself, announcing 'The banner falls.' with an explosion sound (a banner with lifetime 1 survives one more act).",
      "arms": [
        {
          "when": "lifetime >= 1",
          "observable": "lifetime -1, dead 0"
        },
        {
          "when": "lifetime < 1",
          "observable": "dead 1, death() runs: flash fx spawned, SOUND_EXPLODE, notification 'The banner falls.'"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.banner_falls_when_its_time_is_up"
        }
      ],
