    {
      "id": "orc_specials.lua:14",
      "lines": [
        14
      ],
      "kinds": [
        "if"
      ],
      "function": "M.yell",
      "anchor": "if lc.is_busy(self) then",
      "condition": "lc.is_busy(self)  (busy > 0)",
      "semantic": "An orc (or captain) that is busy (> 0) cannot howl; the refusal is free.",
      "arms": [
        {
          "when": "busy > 0",
          "observable": "refused 'SPECIAL BUSY'"
        },
        {
          "when": "busy <= 0",
          "observable": "howl"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.captain_howl_refuses_while_busy",
          "note": "busy 3: SPECIAL BUSY, 0 MP"
        },
        {
          "file": "tests/unit/test_kit_captain.cpp",
          "test": "KitCaptain.promoted_orc_keeps_howl_and_eat_corpse",
          "note": "busy 0: howl ok, 25 MP, foe frozen"
        },
        {
          "file": "tests/integration/test_family_orc.cpp",
          "test": "FamilyOrc.r15_howl_freezes_foes_in_radius_and_spares_the_horde",
          "note": "busy 0: howl ok, busy 2, roar"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "orc_specials.lua:20",
      "lines": [
        20
      ],
      "kinds": [
        "if"
      ],
      "function": "M.yell",
      "anchor": "if gf.on() and #foes == 0 then",
      "condition": "gf.on() and #foes == 0",
      "semantic": "Classic: HOWL with nobody in reach still costs its price, 2 busy and roars. Gameplay Fixes: a howl that would stun nobody is refused for free (NO FOE IN RANGE).",
      "arms": [
        {
          "when": "fixes off, no foe",
          "observable": "SOUND_ROAR emitted, busy +2"
        },
        {
          "when": "fixes on, no foe",
          "observable": "refused, no sound, nothing spent"
        },
        {
          "when": "foe in range",
          "observable": "howl either way"
        }
      ],
      "setting": "both",
      "status": "partial",
      "tests": [
        {
          "parity": "orc_howl_no_foe_scen99",
          "fact": "EventKindExactly(play_sound,1) (fixes off, no foe: the roar)"
        },
        {
          "parity": "orc_howl_no_foe_fixes_scen99",
          "fact": "EventKindExactly(play_sound,0) (fixes on, no foe: refused, no roar)"
        },
        {
          "file": "tests/integration/test_family_orc.cpp",
          "test": "FamilyOrc.r15_howl_freezes_foes_in_radius_and_spares_the_horde",
          "note": "foe in range, fixes OFF leg only"
        }
      ],
      "missing_arms": [
        "foe in range"
      ]
    },
    {
      "id": "orc_specials.lua:31",
      "lines": [
        31,
        33
      ],
      "kinds": [
        "if",
        "else"
      ],
      "function": "M.yell",
      "anchor": "if foe:has_guy() then",
      "condition": "foe:has_guy()",
      "semantic": "HOWL stuns every foe in 160+20*level px for max(0, yell_stun_base + rand(level*10) - rand(con*10)) ticks of frozen_delay, where con is a hero's constitution, or for a guyless foe its hp/30 (trunc); a zero con draws nothing.",
      "arms": [
        {
          "when": "hero foe",
          "observable": "con = guy constitution (con 0: stun 10 + level roll)"
        },
        {
          "when": "guyless foe",
          "observable": "con = trunc(hp/30)"
        },
        {
          "when": "stun negative",
          "observable": "clamped to 0"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_family_orc.cpp",
          "test": "FamilyOrc.r15_howl_freezes_foes_in_radius_and_spares_the_horde",
          "note": "hero foe con 0, orc level 0: frozen_delay exactly 10"
        }
      ],
      "missing_arms": [
        "guyless foe",
        "stun negative"
      ]
    },
