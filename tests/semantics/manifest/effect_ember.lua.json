      "function": "foes_touching",
      "anchor": "if w:order() == C.ORDER_LIVING",
      "condition": "w:order()==LIVING and w:floor()==ent:floor() and hits(ent box grown by grow, w box)",
      "semantic": "IMMOLATE's fire (the embers and the burner's own contact burn) touches only living foes on its own floor whose box overlaps the fire's box (grown by `grow` px for the contact burn); generators, weapons and other-floor foes are not burned, and the 64-px search reach means even the biggest core living is found from any side.",
      "arms": [
        {
          "when": "living foe overlapping on the same floor",
          "observable": "in the touching list (burned)"
        },
        {
          "when": "generator/weapon foe",
          "observable": "excluded"
        },
        {
          "when": "other floor",
          "observable": "excluded"
        },
        {
          "when": "in reach but no overlap",
          "observable": "excluded"
        }
      ],
      "setting": "new-specials",
      "status": "partial",
      "tests": [
        {
          "file": "tests/unit/test_kit_elemental.cpp",
          "test": "KitElemental.embers_burn_crossers_then_die",
          "note": "overlapping crosser and giant burn"
        },
        {
          "file": "tests/unit/test_kit_elemental.cpp",
          "test": "KitElemental.immolate_drains_two_per_tick_burns_contact_melee_most_and_lays_embers",
          "note": "touching foes burn; far foe 120 px, in reach but clear, untouched"
        }
      ],
      "missing_arms": [
        "generator/weapon foe",
        "other floor"
      ],
      "note": [
        "Removed KitElemental.every_core_living_box_fits_the_burn_search: it checks loader box sizes and never runs foes_touching."
      ]
    },
