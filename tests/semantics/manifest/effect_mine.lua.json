      "function": "on_act (core:mine)",
      "anchor": "if self:lifetime() <= 0 then",
      "condition": "self:lifetime() <= 0",
      "semantic": "A mine that nobody steps on for its lifetime (600 + 30 per level ticks) expires quietly: hp is set negative so its death makes no blast.",
      "arms": [
        {
          "when": "lifetime reaches 0",
          "observable": "dead, hp -1, no explosion spawned"
        },
        {
          "when": "time left",
          "observable": "trip scan"
        }
      ],
      "setting": "new-specials",
      "status": "partial",
      "tests": [
