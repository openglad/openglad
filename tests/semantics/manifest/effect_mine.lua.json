      "function": "trips",
      "anchor": "if foe:floor() ~= self:floor() then",
      "condition": "foe floor differs / BIT_FLYING / flight_left > 0",
      "semantic": "A thief's mine is set off only by a foe on its floor who is on its feet: a flying family or a walker under a flight potion floats over it.",
      "arms": [
        {
          "when": "other floor",
          "observable": "no trip"
        },
        {
          "when": "flying family",
          "observable": "no trip"
        },
        {
          "when": "flight potion active",
          "observable": "no trip"
        },
        {
          "when": "grounded foe overlapping the mine box",
          "observable": "trip -> detonate"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_thief.cpp",
          "test": "KitThief.flying_foe_does_not_trip_a_mine"
        },
        {
          "file": "tests/unit/test_kit_thief.cpp",
          "test": "KitThief.mine_detonates_under_a_foe_not_an_ally"
        }
      ],
      "missing_arms": []
    },
