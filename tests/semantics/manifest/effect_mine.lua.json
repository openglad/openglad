      ],
      "function": "on_act (core:mine)",
      "anchor": "if trips(self, foes[i]) then",
      "condition": "trips(self, foes[i])",
      "semantic": "A mine blows under the first foe that trips it; allies walk over their own mines; otherwise it blinks (frame = (world_tick/8) % 2).",
      "arms": [
        {
          "when": "a foe trips it",
          "observable": "mine dead; explosion with the thief's damage at the mine"
        },
        {
          "when": "only allies / nobody",
          "observable": "mine alive; frame toggles every 8 world ticks"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
