      "condition": "self:ani_type() ~= C.ANI_WALK",
      "semantic": "A mine lit by a neighbour's blast blows on its own next act (no recursion inside the first death).",
      "arms": [
        {
          "when": "lit (ani_type EXPLODE)",
          "observable": "dead; explosion spawned this act"
