{
  "path": "packs/core/lib/treasure_valuables.lua",
  "rules": [
    {
      "id": "treasure_valuables.lua:16",
      "lines": [
        16
      ],
      "kinds": [
        "if"
      ],
      "function": "gold_bar_on_eat",
      "anchor": "if eater.team == 0 or eater:has_guy() then",
      "condition": "eater.team == 0 or eater:has_guy()",
      "semantic": "Only team 0 or a roster hero can cash a gold bar: it banks score_per_level*level for the eater's team and is consumed with SOUND_MONEY; a guyless monster leaves it.",
      "arms": [
        {
          "when": "team 0 / hero",
          "observable": "m_score += 200*L, bar dead, money sound"
        },
        {
          "when": "team-1 bot",
          "observable": "no score, bar alive"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "parity": "treasure_gold_bar_team_reject_scen99",
          "fact": "ScoreDelta(1,0,0) + WalkerOfTeamAlive (team-1 bot: no score, bar alive)"
        },
        {
          "parity": "treasure_gold_bar_pickup_scen99",
          "fact": "score fact (team-0 leg of the accept arm)"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.gold_bar",
          "note": "team-0 leg: score rises, bar dead, ScoreChange"
        }
      ],
      "missing_arms": [
        "team 0 / hero"
      ],
      "note": [
        "(the hero leg of \"team 0 / hero\" - a non-zero-team eater with a guy - is asserted nowhere: dropping \"or eater:has_guy()\" keeps every test green)"
      ]
    },
