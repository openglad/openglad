      "anchor": "if eater.team ~= self.team then",
      "condition": "eater.team ~= self.team",
      "semantic": "A life gem (a fallen character's banked hp) can be claimed only by its own team: it banks trunc(max(hp,0)) score, flashes and dies; another team walks over it.",
      "arms": [
        {
          "when": "other team",
          "observable": "gem alive, no score"
        },
        {
          "when": "own team",
          "observable": "score += hp, flash, gem dead"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "parity": "treasure_life_gem_enemy_reject_scen99",
          "fact": "WalkerOfTeamAlive + ScoreDelta(0,0,0) (other team)"
        },
        {
          "parity": "treasure_life_gem_pickup_scen99",
          "fact": "WalkerOfOrderFamilyCount(FLASH) (own team: flash)"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.life_gem",
          "note": "own team: score rises, gem dead"
        }
