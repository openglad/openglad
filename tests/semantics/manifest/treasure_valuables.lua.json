      "function": "key_on_eat",
      "anchor": "if (eater:keys() & key_mask) == 0 then  -- just got it?",
      "condition": "(eater:keys() & key_mask) == 0",
      "semantic": "A key sets bit 1<<clamp(level,0,30) on the eater's own key mask; touching a key it already holds is silent (no message, mask unchanged).",
      "arms": [
        {
          "when": "new key",
          "observable": "keys |= bit, message"
        },
        {
          "when": "already held",
          "observable": "nothing"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_pack_lua_paths.cpp",
          "test": "PackLuaTreasure.a_key_already_held_is_a_silent_no_op",
          "note": "new key: keys == 4, one message; held: mask unchanged, no second message"
        },
        {
          "parity": "treasure_key_pickup_scen99",
          "fact": "EventKindAtLeast(notification,1)"
        }
      ],
