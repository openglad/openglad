{
  "path": "packs/core/lib/weapon_rock.lua",
  "rules": [
    {
      "id": "weapon_rock.lua:8",
      "lines": [
        8,
        9
      ],
      "function": "on_death",
      "anchor": "if self:do_bounce() == 0 or self:lineofsight() == 0",
      "condition": "do_bounce == 0 or lineofsight == 0 or collide_ob ~= nil",
      "semantic": "Only an elf's bouncing rock that dies by striking terrain bounces; a non-bouncing rock, a rock that has run out of range (lineofsight 0) or a rock that hit a walker dies normally.",
      "arms": [
        {
          "when": "do_bounce 0",
          "observable": "rock stays dead, hook false"
        },
        {
          "when": "lineofsight 0",
          "observable": "rock stays dead, no reposition"
        },
        {
          "when": "collide_ob set (hit a walker)",
          "observable": "rock stays dead, no reposition"
        },
        {
          "when": "bouncing rock hit terrain",
          "observable": "bounce chain (weapon_rock.lua:17)"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_weap_behavior.cpp",
          "test": "WeapBehavior.weapon_family_rock_death_bounce_matrix"
        }
      ],
      "missing_arms": [
        "lineofsight 0",
        "collide_ob set (hit a walker)"
      ]
    },
    {
      "id": "weapon_rock.lua:17",
      "lines": [
        17,
        24,
        33,
        42
      ],
      "function": "on_death",
      "anchor": "if og.query_grid_passable(og.fadd(self:xpos(), self:lastx()),",
      "condition": "query_grid_passable at (x+dx,y+dy), (x-dx,y+dy), (x+dx,y-dy), (x-dx,y-dy) in that order",
      "semantic": "A bouncing rock that died against a barrier reflects: if its forward cell is actually open it dies normally; otherwise it tries flipping X, then flipping Y, then flipping both, takes the first open cell (moving there and reversing that velocity component) and lives on; if all are blocked it dies.",
      "arms": [
        {
          "when": "forward cell passable",
          "observable": "dead 1, hook false, no move"
        },
        {
          "when": "X-flip cell open",
          "observable": "setxy(x-dx, y+dy), lastx negated, lasty kept, dead 0, death_called 0"
        },
        {
          "when": "Y-flip cell open",
          "observable": "setxy(x+dx, y-dy), lasty negated, dead 0"
        },
        {
          "when": "both-flip cell open",
          "observable": "setxy(x-dx, y-dy), both negated, dead 0"
        },
        {
          "when": "all blocked",
          "observable": "dead 1, hook false"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_weap_behavior.cpp",
          "test": "WeapBehavior.weapon_family_rock_death_bounce_matrix"
        }
      ],
      "missing_arms": [
        "X-flip cell open",
        "Y-flip cell open",
        "both-flip cell open"
      ]
    }
  ],
  "other": []
}
