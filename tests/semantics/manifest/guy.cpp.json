      ],
      "function": "stat_cost_curve_contribution / raise_stat_cost_curve",
      "anchor": "if (value <= 0)",
      "condition": "value <= 0 || stat_cost <= 0",
      "semantic": "A trained stat adds to a hero's worth (life-gem/heart value and price) by (points above the family base)^1.85 x the family's per-stat cost, computed deterministically; a stat at or below base, or a family with a zero cost for that stat, adds nothing; the sum saturates at INT32_MAX.",
      "arms": [
        {
          "when": "delta <= 0 or stat_cost <= 0",
          "observable": "contribution 0: query_heart_value == hiring_cost"
        },
        {
          "when": "delta > 0",
          "observable": "query_heart_value == hiring_cost + floor-ish(delta^1.85*cost) e.g. soldier STR+8 -> 531, STR+3000 -> 16249210"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_guy_calcs.cpp",
          "test": "GuyCalcs.guy_query_heart_value_with_stats"
        },
        {
          "file": "tests/integration/test_guy_calcs.cpp",
          "test": "GuyCalcs.guy_query_heart_value_large_delta_matches_legacy_curve"
        },
        {
          "file": "tests/integration/test_guy_extended.cpp",
          "test": "GuyExtended.guy_round10_query_heart_value_clamps_negative_stat_deltas_to_base_cost",
          "note": "delta <= 0 half only"
        },
        {
          "file": "tests/integration/test_guy_extended.cpp",
          "test": "GuyExtended.guy_query_heart_value_all_families",
          "note": "delta 0 half only"
        },
        {
          "file": "tests/unit/test_sem_ai_1.cpp",
          "test": "SemGuy.a_stat_trained_on_a_family_that_prices_it_at_zero_adds_nothing_to_its_worth"
        }
      ],
      "missing_arms": []
    },
