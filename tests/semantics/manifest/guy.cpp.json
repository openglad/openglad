          "observable": "max_heal_delay = REGEN/(rem+1)"
        },
        {
          "when": "remainder <= 1",
          "observable": "max_heal_delay stays REGEN"
        },
        {
          "when": "computed delay < 2",
          "observable": "max_heal_delay==2"
