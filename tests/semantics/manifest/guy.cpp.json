      "function": "check_special_ai_distance (og.check_special_ai_distance; packs/core/lib/ai.lua foe_within, kit_captain.lua, kit_elemental.lua)",
      "anchor": "if (self->foe())",
      "condition": "self->foe() / !self->foe() after find_near_foe",
      "semantic": "A bot's 'foe within N' special gate measures to the foe it already has; only a walker with no foe acquires the nearest foe (and keeps it as its foe); with no foe to find the gate is closed; the distance test is strict (< N).",
      "arms": [
        {
          "when": "has foe, distance < N",
          "observable": "true; foe unchanged"
        },
        {
          "when": "has foe, distance >= N",
          "observable": "false even if another foe is nearer; foe unchanged"
        },
        {
          "when": "no foe, find_near_foe finds one within N",
          "observable": "true; self.foe set to it"
        },
        {
          "when": "no foe, none found",
          "observable": "false; foe stays nil"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
