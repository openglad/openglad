      "function": "M.pad_blocked_by_terrain",
      "anchor": "return M.on() and self:fire_pad_answer() == \"terrain\"",
      "condition": "M.on() and self:fire_pad_answer() == \"terrain\"",
      "semantic": "With Gameplay Fixes on (AC), an elf or druid volley/bolt whose launch pad is refused by terrain (a wall face, the map edge, a tree crown for a non-forest weapon; never water) is refused before the refund and the swing; a body on the pad does not count (fixes H/I keep that paid blow). Classic: the cast swings at nothing and still pays.",
      "arms": [
        {
          "when": "fixes off",
          "observable": "false always (classic: cast proceeds, one swing paid)"
        },
        {
          "when": "fixes on, pad on terrain",
          "observable": "true: cast refused, nothing spent"
        },
        {
          "when": "fixes on, body on pad or pad clear",
          "observable": "false"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_lib.cpp",
          "test": "GameplayFixesLua.gf_pad_blocked_by_terrain_is_the_grid_half_only_with_the_fixes"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_volley_at_a_wall_spends_nothing_with_the_setting_on"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_druid.cpp",
          "test": "GameplayFixesDruid.a_cast_at_terrain_spends_nothing_with_the_setting_on"
        }
      ],
