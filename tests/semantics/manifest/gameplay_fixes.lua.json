      "function": "M.nearest_charmable",
      "anchor": "if eligible and max_level ~= nil then",
      "condition": "eligible and max_level ~= nil / eligible / best == nil or dist < best_dist",
      "semantic": "With Gameplay Fixes on, the thief's and archmage's charms pick the nearest charmable foe (distance_to_ob), ties to the first in the list, and only one at or below the caster's level where a level cap applies (a higher level always resists). Draws nothing.",
      "arms": [
        {
          "when": "foe above max_level",
          "observable": "ineligible"
        },
        {
          "when": "eligible and nearer",
          "observable": "becomes best"
        },
        {
          "when": "equal distance",
          "observable": "first in list kept"
        },
        {
          "when": "none eligible",
          "observable": "nil"
        }
      ],
      "setting": "fixes-on",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_lib.cpp",
          "test": "GameplayFixesLua.gf_nearest_charmable_takes_the_nearest_eligible_foe"
        },
