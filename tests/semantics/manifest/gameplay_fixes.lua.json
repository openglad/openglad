      "function": "M.special_busy",
      "anchor": "if M.on() then",
      "condition": "M.on() -> busy > 0 ; else busy ~= 0",
      "semantic": "The soldier's WHIRLWIND/DISARM and the archer's BARRAGE/EXPLODING BOLT refuse SPECIAL BUSY while busy. Classic: any non-zero busy refuses, so a hero whose fractional fire delay left busy a hair below zero is refused forever. Fixed: busy at or below zero is not busy.",
      "arms": [
        {
          "when": "fixes off, busy < 0 (e.g. -0.2 after a hero shot)",
          "observable": "SPECIAL BUSY forever"
        },
        {
          "when": "fixes on, busy <= 0",
          "observable": "casts"
        },
        {
          "when": "busy > 0",
          "observable": "busy on both"
        },
        {
          "when": "busy == 0",
          "observable": "casts on both"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_special_busy.cpp",
          "test": "GameplayFixesSpecialBusy.whirlwind_after_a_shot"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_special_busy.cpp",
          "test": "GameplayFixesSpecialBusy.disarm_after_a_shot"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_special_busy.cpp",
          "test": "GameplayFixesSpecialBusy.archer_specials_after_a_shot"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_special_busy.cpp",
          "test": "GameplayFixesSpecialBusy.positive_and_zero_busy_are_unchanged"
        }
      ],
      "missing_arms": []
    },
