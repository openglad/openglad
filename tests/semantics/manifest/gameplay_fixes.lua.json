      "function": "M.turn_range",
      "anchor": "if not M.on() then",
      "condition": "not M.on()",
      "semantic": "TURN UNDEAD reaches 4 px per cleric level; with Gameplay Fixes on it never reaches less than turn_undead_range_min (60 px). The roll strength is unchanged.",
      "arms": [
        {
          "when": "fixes off",
          "observable": "reach = 4*level (L1: 4 px)"
        },
        {
          "when": "fixes on",
          "observable": "reach = max(4*level, 60)"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_lib.cpp",
          "test": "GameplayFixesLua.gf_turn_range_has_a_floor_only_when_on"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_cleric.cpp",
          "test": "GameplayFixesCleric.turn_undead_reaches_sixty_px_when_on"
        }
      ],
      "missing_arms": []
    },
    {
