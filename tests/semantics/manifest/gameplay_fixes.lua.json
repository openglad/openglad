      "function": "M.charmable",
      "anchor": "if foe:real_team_num() ~= 255 then",
      "condition": "real_team_num ~= 255 / order ~= LIVING / not fixes",
      "semantic": "A charm can take a foe that is not already charmed and is a living body; with Gameplay Fixes on, never a hero a player is driving (HERO RESISTS).",
      "arms": [
        {
          "when": "already charmed (real_team_num ~= 255)",
          "observable": "false"
        },
        {
          "when": "not living order",
          "observable": "false"
        },
        {
          "when": "fixes off",
          "observable": "true"
        },
        {
          "when": "fixes on and seat-driven",
          "observable": "false"
        },
        {
          "when": "fixes on and not driven",
          "observable": "true"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_lib.cpp",
          "test": "GameplayFixesLua.gf_charmable_skips_a_seated_hero_only_with_the_fixes"
        }
      ],
      "missing_arms": []
    },
