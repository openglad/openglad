      "semantic": "A bot captain hooks (shift 0) a living foe within the blade's 60 px reach when no blade is out and he can pay 40; else fans (shift 1) when two living foes stand on the fan's lines within knife flight and he is not busy; else holds. Off: true, coin untouched.",
      "arms": [
        {
          "when": "off",
          "observable": "true, shifter_down unchanged (9)"
        },
        {
          "when": "foe at 50/60 px, no blade, 40 MP",
          "observable": "true, shift 0"
        },
        {
          "when": "61 px",
          "observable": "false"
        },
        {
          "when": "35 MP",
          "observable": "hook refused -> fan if crowd"
        },
        {
          "when": "blade out, one foe",
          "observable": "false"
        },
        {
          "when": "two on the lines",
          "observable": "true, shift 1"
        },
        {
          "when": "busy",
          "observable": "false, coin stands"
        }
      ],
