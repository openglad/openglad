      ],
      "function": "M.living_foes",
      "anchor": "for i = 1, #found do",
      "condition": "w:order() == C.ORDER_LIVING ; not floor_only or w:floor() == floor",
      "semantic": "A bot gate's 'foes' are living bodies only (a generator the finder counts as a foe is never one), within the finder's Manhattan range between top-left corners (inclusive), and, when asked, only those on the caster's own floor.",
      "arms": [
        {
          "when": "a living foe in range, same floor",
          "observable": "counted"
        },
        {
          "when": "a generator foe in range",
          "observable": "not counted (finder count 3, living_foes 2)"
        },
        {
          "when": "a living foe in range on another floor, floor_only true",
          "observable": "not counted; counted with floor_only false"
        },
        {
          "when": "a foe at exactly range px",
          "observable": "counted (inclusive); at range+1 not"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_bot_gates_lib.cpp",
          "test": "BotGatesLib.living_foes_skips_generators"
        }
      ],
      "missing_arms": []
    },
