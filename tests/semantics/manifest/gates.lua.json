      "function": "M.fire_heading",
      "anchor": "function M.fire_heading(self)",
      "condition": "self:facing(og.trunc(self:lastx()), og.trunc(self:lasty()))",
      "semantic": "Where a fired weapon leaves is facing(lastx, lasty), not curdir: at spawn lastx = lasty = 0 and facing(0, 0) is FACE_UP (while curdir is DOWN); a fractional aim is truncated toward zero first, so lastx -0.5 reads as 0 and the heading is UP.",
      "arms": [
        {
          "when": "spawn (0,0)",
          "observable": "FACE_UP while curdir FACE_DOWN"
        },
        {
          "when": "lastx 1",
          "observable": "FACE_RIGHT, even after set_curdir(FACE_LEFT)"
        },
        {
          "when": "lastx -0.5",
          "observable": "FACE_UP (truncated)"
        },
        {
          "when": "(3,3) / (-3,3)",
          "observable": "FACE_DOWN_RIGHT / FACE_DOWN_LEFT"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
