      "anchor": "if (map != nullptr)",
      "condition": "map && !ignore && !dormant && !hidden",
      "semantic": "Only tangible walkers are in the collision map: repositioning a normal walker re-buckets it at the new spot; repositioning an ignored (blood, walk-over), dormant (delayed spawn) or hidden (burrowed) walker removes it instead, so it blocks nothing and is found by nothing until it becomes tangible again (set_dormant(false)/set_hidden(false) re-register).",
      "arms": [
        {
          "when": "tangible",
          "observable": "walker_to_pos has it at the new cells; old cell pile no longer holds it"
        },
        {
          "when": "ignore",
          "observable": "removed: walker_to_pos.count==0, position still updated"
        },
        {
          "when": "dormant",
          "observable": "stays unregistered"
        },
        {
          "when": "hidden",
          "observable": "stays unregistered"
        },
        {
          "when": "no world map",
          "observable": "position only"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_walker_movement.cpp",
          "test": "WalkerMovement.walker_setxy_moves_obmap_registration",
          "note": "tangible: re-bucketed, old cell empty; ignore: removed, position updated"
        },
        {
          "file": "tests/integration/test_walker_movement_unit.cpp",
          "test": "WalkerMovementUnit.walker_movement_r11_move_worldmove_setxy_and_setworldxy",
          "note": "ignore: walker_to_pos.count == 0"
