      "function": "plant_tree",
      "anchor": "if gf.pad_blocked_by_terrain(self) then",
      "condition": "if gf.pad_blocked_by_terrain(self) then return false, \"COULD NOT FIRE\"",
      "semantic": "Gameplay Fixes: a druid aiming its bolt into terrain (wall/map edge on the fire pad) is refused before anything is paid (same rule in plant_tree :16 and summon_faerie :45). Classic: the cast goes on to fire() and fails there.",
      "arms": [
        {
          "when": "fixes on, pad on terrain",
          "observable": "false 'COULD NOT FIRE', MP unchanged"
        },
        {
          "when": "fixes off or pad clear",
          "observable": "fire attempted"
        }
      ],
      "setting": "fixes-on",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_druid.cpp",
          "test": "GameplayFixesDruid.a_cast_at_terrain_spends_nothing_with_the_setting_on"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_druid.cpp",
          "test": "GameplayFixesDruid.a_cast_at_the_map_edge_spends_nothing"
