          "observable": "true; MP spent; no undead destroyed; SOUND_HEAL"
        },
        {
          "when": "living foes only, setting on",
          "observable": "false 'NO UNDEAD IN RANGE'; MP unchanged"
        },
        {
          "when": "undead in reach",
          "observable": "true; turned n (rolls per undead)"
        }
      ],
      "setting": "both",
