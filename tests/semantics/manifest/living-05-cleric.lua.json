      "condition": "not self:has_guy() -> false; else INT < turn_undead_int_req (60)",
      "semantic": "Only a hero needs 60 INT to TURN UNDEAD; a bot cleric always has the INT. Shared by the cast (:33) and the fixed bot gate (:340).",
      "arms": [
        {
          "when": "bot",
          "observable": "never lacks"
        },
        {
          "when": "hero INT < 60",
          "observable": "lacks"
        },
        {
          "when": "hero INT >= 60",
          "observable": "does not lack"
        }
      ],
      "setting": "none",
      "status": "asserted",
