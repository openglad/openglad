      "function": "volley (fixed bot gate helper)",
      "anchor": "if not foe or not G.faces(self, foe)",
      "condition": "not foe or not G.faces(self, foe) or not G.in_flight(self, foe, 5, 8, los_num, 2)",
      "semantic": "Gameplay Fixes bot elf: a volley needs its nearest living foe (within 320 px) faced along the elf's heading and inside the rock's flight (step 5 x range 8, multiplied by los_num/2 for bouncing volleys).",
      "arms": [
        {
          "when": "no living foe",
          "observable": "false"
        },
        {
          "when": "foe not faced",
          "observable": "false"
        },
        {
          "when": "foe beyond flight",
          "observable": "false"
        },
        {
          "when": "faced and in flight",
          "observable": "continue (true for 1-foe volleys)"
        }
      ],
      "setting": "fixes-on",
      "status": "partial",
      "tests": [
        {
          "file": "tests/unit/test_bot_gates_fighters.cpp",
