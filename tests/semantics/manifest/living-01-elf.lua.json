      "function": "bounce_volley",
      "anchor": "if gf.on() then",
      "condition": "if gf.on() then refund = count",
      "semantic": "Classic bouncing volleys refund cost_mult weapon costs (3/4/5) while firing only count rocks (2/3/4): each volley over-refunds one rock (net MP gain). Gameplay Fixes refunds exactly the rocks that fly.",
      "arms": [
        {
          "when": "setting off",
          "observable": "MP after cast = start - slot cost + cost_mult*wc - count*wc (i.e. +1 wc extra)"
        },
        {
          "when": "setting on",
          "observable": "MP after = start - slot cost (refund == rocks fired)"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.volleys_refund_exactly_the_rocks_fired",
          "note": "slots 2-4: off price-(refund-rocks)wc, on exact price"
        },
        {
          "parity": "elf_volley_refund_scen99",
          "fact": "elf_volley_refund_fixes_scen99 (7 vs 6 sounds, 1 vs 0 rocks)"
        }
      ],
      "missing_arms": []
    },
