      ],
      "function": "bounce_volley",
      "anchor": "if not rock then",
      "condition": "not rock / if gf.on() then take_back(count - i + 1)",
      "semantic": "When a volley's i-th rock cannot be fired the cast stops 'COULD NOT FIRE' with the earlier rocks still flying. Classic keeps the whole refund; Gameplay Fixes takes back the count-i+1 rocks that never flew.",
      "arms": [
        {
          "when": "i-th fire nil, off",
          "observable": "false; i-1 rocks; MP keeps full refund"
        },
        {
          "when": "i-th fire nil, on",
          "observable": "false; i-1 rocks; MP -= (count-i+1)*wc"
        },
        {
          "when": "all fire",
          "observable": "true"
        }
      ],
      "setting": "both",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_blocked_volley_costs_one_swing",
          "note": "i=1 each slot: off 0 rocks, full refund kept; on MP 600-wc"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.volleys_refund_exactly_the_rocks_fired",
          "note": "all fire: true"
        }
      ],
