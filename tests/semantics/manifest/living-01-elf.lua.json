{
  "path": "packs/core/families/living-01-elf.lua",
  "rules": [
    {
      "id": "living-01-elf.lua:19",
      "lines": [
        19
      ],
      "function": "some_rocks (ROCKS, slot 1)",
      "anchor": "if gf.pad_blocked_by_terrain(self) then",
      "condition": "gf.pad_blocked_by_terrain(self)",
      "semantic": "Gameplay Fixes AC: when the rock's launch pad is refused by terrain (wall face, map edge; not a tree crown, not water) the volley is refused 'COULD NOT FIRE' before any refund or swing: it costs nothing. Classic: the cast refunds 2 weapon costs, fire() fails and the one swing is still paid. A body on the pad is not 'terrain' and keeps the paid swing (fixes H/I). Same rule as :54.",
      "arms": [
        {
          "when": "pad on wall/edge, setting on",
          "observable": "special() false 'COULD NOT FIRE'; MP unchanged (special cost not charged); no rock; busy unchanged"
        },
        {
          "when": "pad on wall/edge, setting off",
          "observable": "special() false 'COULD NOT FIRE'; MP net reflects the refund + swing (see :25)"
        },
        {
          "when": "pad on tree crown",
          "observable": "rocks fly (forestwalk)"
        }
      ],
      "setting": "both",
      "status": "partial",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_volley_at_a_wall_spends_nothing_with_the_setting_on",
          "note": "on: COULD NOT FIRE, MP 600, rng/lists unchanged, 0 rocks; off: COULD NOT FIRE, 600+(refund-1)wc"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_volley_at_the_map_edge_spends_nothing",
          "note": "same at the map edge"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_tree_crown_on_the_pad_lets_the_rocks_fly",
          "note": "crown: true, 2 rocks, MP 590"
        },
        {
          "parity": "elf_rocks_blocked_scen99",
          "fact": "_fixes_scen99, elf_rocks_edge_pad_scen99 / _fixes_scen99"
        }
      ],
      "missing_arms": [
        "pad on wall/edge, setting on"
      ]
    },
    {
      "id": "living-01-elf.lua:25",
      "lines": [
