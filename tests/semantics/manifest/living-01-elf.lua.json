      "function": "bounce_volley",
      "anchor": "for i = 1, count do",
      "condition": "for i = 1, count",
      "semantic": "A bouncing volley releases `count` rocks (2/3/4 for slots 2/3/4 and any unmapped slot), each with do_bounce set and line of sight multiplied by los_num/2 (x1.5, x2, x2.5), each with an independent 0.8-1.2 cosmetic speed spread.",
      "arms": [
        {
          "when": "each release",
          "observable": "rock in weaplist with do_bounce==1 and lineofsight == base*los_num//2"
        }
      ],
      "setting": "none",
      "status": "executed-only",
      "tests": [],
      "missing_arms": [
        "each release"
      ]
    },
