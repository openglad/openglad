        26
      ],
      "function": "some_rocks",
      "anchor": "if not rock then",
      "condition": "not rock (first fire failed) / if gf.on()",
      "semantic": "ROCKS pre-refunds two weapon costs so its two rocks are free beyond the slot price; if the first rock cannot be fired the cast fails 'COULD NOT FIRE'. Classic keeps the 2-rock refund even though none flew (net MP gain over the swing); Gameplay Fixes takes both back.",
      "arms": [
        {
          "when": "first fire nil, setting off",
          "observable": "false 'COULD NOT FIRE'; MP = start + 2*wc - (one swing wc)"
        },
        {
          "when": "first fire nil, setting on",
          "observable": "false; MP = start - one swing (take_back 2)"
        },
        {
          "when": "first fire ok",
          "observable": "spread multiplier applied; second fire"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.a_blocked_volley_costs_one_swing",
          "note": "slot 1, foe on pad: off 600+wc, on 600-wc, COULD NOT FIRE, 0 rocks"
        },
        {
          "file": "tests/integration/test_gameplay_fixes_elf.cpp",
          "test": "GameplayFixesElf.volleys_refund_exactly_the_rocks_fired",
          "note": "slot 1 first fire ok: 2 rocks"
        },
        {
          "parity": "elf_rocks_pair_scen99",
          "fact": "",
          "note": "WeaponSpeed 890-920: the spread-scaled pair"
        }
      ],
      "missing_arms": []
    },
