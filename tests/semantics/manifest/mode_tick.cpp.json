      "anchor": "if (!world.mode.win_latched)",
      "condition": "!world.mode.win_latched",
      "semantic": "The first time a scripted match is ended, every queued respawn fires and eligible player corpses revive before the result is recorded; ending it again (last write wins on ending/next_level) does not re-flush.",
      "arms": [
        {
          "when": "first arming",
          "observable": "queued respawns fired, dead heroes alive, win_ending/next_level stored"
        },
        {
          "when": "re-arming",
          "observable": "no flush (a hero killed after the first end stays dead), new ending/next_level overwrite"
        }
      ],
      "setting": "none",
      "status": "executed-only",
