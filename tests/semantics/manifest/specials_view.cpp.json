      "function": "bot_slot_roll_bound",
      "anchor": "for (int slot = 1; slot < FD_NUM_SPECIALS; ++slot) {",
      "condition": "slot > bound && named_open ; named_open ; gameplay_fixes && bound > highest",
      "semantic": "A bot rolls its special among the first (level+2)/3 slots, raised to include any named slot its class opens early; classic: the bound may exceed the last named slot, so an out-of-range roll folds back to slot 1; Gameplay Fixes on: the bound stops at the highest named open slot.",
      "arms": [
        {
          "when": "classic count",
          "observable": "(level+2)/3"
        },
        {
          "when": "named slot opens early",
          "observable": "bound raised to that slot"
        },
        {
          "when": "fixes on and bound past last named",
          "observable": "bound = highest named open slot"
        },
        {
          "when": "fixes off",
          "observable": "bound unclamped"
        }
      ],
      "setting": "both",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_specials_view.cpp",
          "test": "SpecialsView.the_bot_slot_roll_bound_is_the_classic_count_unless_a_row_opens_early"
        },
        {
          "file": "tests/unit/test_specials_view.cpp",
          "test": "SpecialsView.the_bot_slot_roll_bound_with_gameplay_fixes_on_stops_at_the_last_named_slot"
        }
