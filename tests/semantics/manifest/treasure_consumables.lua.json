    {
      "id": "treasure_consumables.lua:38",
      "lines": [
        38
      ],
      "kinds": [
        "if"
      ],
      "function": "magic_potion_on_eat",
      "anchor": "if eater.magicpoints < eater.max_magicpoints then",
      "condition": "eater.magicpoints < eater.max_magicpoints",
      "semantic": "A mana potion first tops the pool up to max (never lowers an overfilled pool), then overfills it by mana_overfill_per_level * level.",
      "arms": [
        {
          "when": "below max",
          "observable": "mp = max + 50*level"
        },
        {
          "when": "already above max",
          "observable": "mp + 50*level (no reset down)"
        }
      ],
      "setting": "none",
      "status": "executed-only",
      "tests": [],
      "missing_arms": [
        "below max",
        "already above max"
      ]
    },
    {
      "id": "treasure_consumables.lua:50",
      "lines": [
        50
      ],
      "kinds": [
        "if"
      ],
      "function": "flight_potion_on_eat",
      "anchor": "if not eater:s_query_bit_flags(C.BIT_FLYING) then",
      "condition": "not BIT_FLYING",
      "semantic": "A natural flyer gains nothing from a flight potion and leaves it on the ground; anyone else gains duration_per_level*level flight ticks and consumes it.",
      "arms": [
        {
          "when": "flyer",
          "observable": "flight_left 0, potion alive, no notice"
        },
        {
          "when": "walker",
          "observable": "flight_left += d*L, consumed"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "parity": "treasure_flight_potion_flier_noconsume_scen99",
          "fact": "WalkerOfTeamAlive + EventKindExactly(notification,0) (flyer)"
        },
        {
          "file": "tests/unit/test_pack_lua_paths.cpp",
          "test": "PackLuaTreasure.a_potion_that_cannot_help_its_eater_is_left_untouched",
          "note": "flyer: flight_left 0, potion alive"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.flight_potion",
          "note": "walker: flight_left > 0, potion dead; the exact d*L amount is not pinned"
        }
      ],
      "missing_arms": []
    },
