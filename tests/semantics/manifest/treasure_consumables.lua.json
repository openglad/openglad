    {
      "id": "treasure_consumables.lua:9",
      "lines": [
        9
      ],
      "kinds": [
        "if"
      ],
      "function": "notify_potion_consume",
      "anchor": "if eater:user() ~= -1 then",
      "condition": "eater:user() ~= -1",
      "semantic": "A potion's \"Potion of <X>(<level>)!\" line goes only to a seated eater's own view; a bot eats silently; the potion is consumed either way.",
      "arms": [
        {
          "when": "seated eater",
          "observable": "one Notification addressed to that seat, potion dead"
        },
        {
          "when": "bot eater",
          "observable": "no notification, potion dead"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "parity": "treasure_magic_potion_pickup_scen99",
          "fact": "EventKindAtLeast(notification,1) (seated eater)"
        },
        {
          "parity": "treasure_invis_potion_pickup_scen99",
          "fact": "EventKindAtLeast(notification,1) (seated eater)"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.magic_potion",
          "note": "seated eater: potion dead"
        }
      ],
      "missing_arms": [
        "bot eater"
      ]
    },
    {
      "id": "treasure_consumables.lua:18",
      "lines": [
        18
      ],
      "kinds": [
        "if"
      ],
      "function": "drumstick_on_eat",
      "anchor": "if eater.hp >= eater.max_hp then",
      "condition": "eater.hp >= eater.max_hp",
      "semantic": "A drumstick is left untouched by an eater at full health (no heal, no sound, stays alive).",
      "arms": [
        {
          "when": "full hp",
          "observable": "drumstick alive, no SOUND_EAT"
        },
        {
          "when": "wounded",
          "observable": "heal base + rand0(base), dead, SOUND_EAT"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "parity": "treasure_drumstick_fullhp_noconsume_scen99",
          "fact": "WalkerOfTeamAlive + EventKindExactly(play_sound,0) (full hp: alive, no SOUND_EAT)"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.drumstick_full_hp",
          "note": "hp unchanged, drumstick not dead"
        },
        {
          "file": "tests/integration/test_treasure_eat.cpp",
          "test": "TreasureEat.drumstick",
          "note": "wounded: hp in the base + rand0(base) band 60..69"
        },
        {
          "parity": "treasure_drumstick_pickup_scen99",
          "fact": "WalkerHpRangeAtFinalTick (wounded: healed band)"
        }
      ],
      "missing_arms": []
    },
