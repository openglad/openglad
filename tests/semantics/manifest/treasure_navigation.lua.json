      "function": "teleporter_on_eat",
      "anchor": "if eater:skip_exit() > 1 then",
      "condition": "skip_exit > 1 ; dist > 21 ; dist < 4 and skip_exit ~= 0",
      "semantic": "A warp pad fires only for an eater not throttled (skip_exit <= 1) and within 21 px of the pad's centre; an eater standing at the very centre (< 4 px) with a pending skip is held (skip_exit = 8) instead of warped back.",
      "arms": [
        {
          "when": "skip_exit > 1",
          "observable": "nothing"
        },
        {
          "when": "dist > 21",
          "observable": "nothing"
        },
        {
          "when": "dist < 4 and skip_exit 1",
          "observable": "skip_exit = 8, no warp"
        },
        {
          "when": "otherwise",
          "observable": "skip_exit += 20, warp"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/integration/test_runtime_coverage_paths.cpp",
          "test": "RuntimeCoveragePaths.treasure_navigation_early_returns_and_withdraw_decline",
          "note": "skip_exit 5: stays 5; 200 px away: stays 0"
        },
