  "rules": [
    {
      "id": "living_common.lua:22",
      "lines": [
        22
      ],
      "function": "M.mid_teleport",
      "anchor": "return ani == C.ANI_TELE_OUT or ani == C.ANI_TELE_IN",
      "condition": "ani == ANI_TELE_OUT or ani == ANI_TELE_IN",
      "semantic": "A walker in either half of a teleport (going out or coming in) is mid-teleport and cannot start the specials that guard on it (TUNNEL, DIG IN, mage teleport).",
      "arms": [
        {
          "when": "TELE_IN",
          "observable": "busy"
        },
        {
          "when": "TELE_OUT",
          "observable": "busy"
        },
        {
          "when": "other",
          "observable": "free"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
          "test": "KitSkeleton.tunnel_and_level_up_stay_classic"
        },
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
          "test": "KitSkeleton.possessed_body_cannot_dig_in"
        }
      ],
      "missing_arms": [],
      "note": [
        "(TELE_IN arm asserted; TELE_OUT arm only via TUNNEL's classic twin)"
      ]
    },
    {
      "id": "living_common.lua:68",
      "lines": [
        68,
        72
      ],
      "function": "M.with_rest",
      "anchor": "if left > 0 and self:special_rest_slot() == slot then",
      "condition": "left > 0 and special_rest_slot() == slot ; if ok",
      "semantic": "A rested special refuses \"<NAME> IN <N>S\" for free while its rest runs on its own slot; a successful cast starts the rest (tuning rest_key ticks) on that slot; a refused cast starts nothing. One clock per walker: only the last rested slot waits. Holds whatever the New Specials setting.",
      "arms": [
        {
          "when": "resting on this slot",
          "observable": "refused 'HOWL IN 10S' etc, nothing spent"
        },
        {
          "when": "rest on another slot",
          "observable": "cast allowed"
        },
        {
          "when": "cast ok",
          "observable": "special_rest_left = tuning, slot = this"
        },
        {
          "when": "cast refused",
          "observable": "rest unchanged"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_rests.cpp",
          "test": "KitRests.orc_howl_rests_ten_seconds"
        },
        {
          "file": "tests/unit/test_kit_rests.cpp",
          "test": "KitRests.freeze_time_rests_thirty_seconds"
        },
        {
          "file": "tests/unit/test_kit_rests.cpp",
          "test": "KitRests.the_clock_is_on_the_walker"
        },
        {
          "file": "tests/unit/test_kit_rests.cpp",
          "test": "KitRests.with_the_setting_off_the_classic_specials_rest_too"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "living_common.lua:85",
      "lines": [
        85,
        86,
        87
      ],
      "function": "M.gate_with_rest",
      "anchor": "if self:current_special() == slot",
      "condition": "current_special()==slot and special_rest_slot()==slot and special_rest_left()>0",
      "semantic": "A bot never picks a special while it is resting; other slots and a rested-out special answer their own gate.",
      "arms": [
        {
          "when": "on rested slot during rest",
          "observable": "gate false"
        },
        {
          "when": "other slot",
          "observable": "gate answers"
        },
        {
          "when": "rest over",
          "observable": "gate answers"
        }
      ],
      "setting": "none",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_rests.cpp",
          "test": "KitRests.bot_gates_hold_a_resting_special"
        }
      ],
