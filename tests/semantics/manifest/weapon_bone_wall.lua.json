{
  "path": "packs/core/lib/weapon_bone_wall.lua",
  "rules": [
    {
      "id": "weapon_bone_wall.lua:17",
      "lines": [
        17
      ],
      "function": "on_animate",
      "anchor": "if left <= 0 then",
      "condition": "left = lifetime - 1; left <= 0",
      "semantic": "A skeleton's bone-wall segment stands for exactly its lifetime in ticks (decrement first): lifetime 2 survives one act and falls on the second.",
      "arms": [
        {
          "when": "left > 0",
          "observable": "lifetime == left, dead 0"
        },
        {
          "when": "left <= 0",
          "observable": "dead 1; weap::animate runs death() (hook returned false)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
          "test": "KitSkeleton.wall_cracks_below_half",
          "note": "lifetime 2 -> alive, then dead"
        }
      ],
      "missing_arms": []
    },
    {
      "id": "weapon_bone_wall.lua:23",
      "lines": [
        23,
        25
      ],
      "function": "on_animate",
      "anchor": "if self.hp < og.fdiv(self.max_hp, 2.0) then",
      "condition": "self.hp < max_hp / 2.0",
      "semantic": "A bone wall shows its cracked frame strictly below half health; at exactly half or above it looks whole.",
      "arms": [
        {
          "when": "hp < max/2",
          "observable": "frame 1 (cracked)"
        },
        {
          "when": "hp >= max/2",
          "observable": "frame 0 (whole)"
        }
      ],
      "setting": "new-specials",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_kit_skeleton.cpp",
          "test": "KitSkeleton.wall_cracks_below_half",
          "note": "27/56 cracked, 28/56 whole"
        }
      ],
      "missing_arms": []
    }
  ],
  "other": []
}
