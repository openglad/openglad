      "function": "freeze_wanted (bot FREEZE TIME cue)",
      "anchor": "return engaged >= 3 or hurt",
      "condition": "engaged >= 3 or hurt",
      "semantic": "Gameplay Fixes bot FREEZE TIME is wanted when the mage's allies are in a fight worth stopping time for: three or more living foes within a blow of allies (each foe counted once however many allies it touches), or an ally at blows that is under a quarter of its health. Distance to the mage itself is not consulted.",
      "arms": [
        {
          "when": "3+ distinct foes at blows with allies",
          "observable": "true"
        },
        {
          "when": "an ally at blows below 1/4 hp",
          "observable": "true"
        },
        {
          "when": "2 foes at blows, allies healthy",
          "observable": "false"
        },
        {
          "when": "crowd at the mage only, no ally engaged",
          "observable": "false"
        }
      ],
      "setting": "fixes-on",
      "status": "asserted",
      "tests": [
        {
          "file": "tests/unit/test_gameplay_fixes_bots.cpp",
          "test": "GameplayFixesBots.mage_freeze_time_waits_for_three_foes_at_blows_with_allies_with_the_setting_on",
          "note": "3 foes at blows -> EXPECT_TRUE; third foe a pixel out -> EXPECT_FALSE"
        },
        {
          "file": "tests/unit/test_gameplay_fixes_bots.cpp",
          "test": "GameplayFixesBots.mage_freeze_time_leaves_a_crowd_at_the_mage_to_teleport_with_the_setting_on",
          "note": "4 foes at the mage, no ally engaged -> EXPECT_FALSE"
        },
        {
          "file": "tests/unit/test_gameplay_fixes_bots.cpp",
          "test": "GameplayFixesBots.mage_freeze_time_counts_foes_once_and_takes_a_dying_ally_as_the_cue_with_the_setting_on",
          "note": "ally at 99/400 at blows -> EXPECT_TRUE; two shared foes -> EXPECT_FALSE"
        }
      ],
      "missing_arms": []
    },
