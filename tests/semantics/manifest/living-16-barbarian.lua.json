    {
      "id": "living-16-barbarian.lua:35",
      "lines": [
        35,
        43
      ],
      "function": "do_special",
      "anchor": "if self:has_guy() then",
      "condition": "if self:has_guy() then stepsize = 1 + strength//7; damage += strength/5 else stepsize = 2*level; damage += level",
      "semantic": "A hero's boulder rolls at 1 + strength/7 px a step and hits for strength/5 extra; a monster's rolls at 2 px per level and hits for its level extra.",
      "arms": [
        {
          "when": "hero (strength 14)",
          "observable": "stepsize 3, damage = base + 2.8"
        },
        {
          "when": "monster level L",
          "observable": "stepsize 2L (then clamped), damage = base + L"
        }
      ],
      "setting": "none",
      "status": "executed-only",
      "tests": [],
      "missing_arms": [
        "hero (strength 14)",
        "monster level L"
      ]
    },
