      ],
      "function": "do_special",
      "anchor": "if not shot then",
      "condition": "if not shot then return false, \"COULD NOT FIRE\"",
      "semantic": "A boulder rides on the barbarian's hammer shot: if the hammer cannot be fired (blocked pad, no MP) there is no boulder. With a body on the pad the classic fire() lands a melee blow instead.",
      "arms": [
        {
          "when": "shot fired",
          "observable": "boulder made at the shot, shot dead"
        },
        {
          "when": "no shot",
          "observable": "false 'COULD NOT FIRE', no boulder"
        }
      ],
      "setting": "none",
      "status": "executed-only",
      "tests": [
        {
          "parity": "barbarian_bot_boulder_pad_body_scen99",
          "fact": "",
          "note": "reaches the no-shot arm; its facts (EventKindExactly(play_sound 1)  WalkerHpRangeAtFinalTick(TOWER1 10400 10400)  WeaponFamilyCount(HAMMER 0 0)) assert the classic melee blow  not the absence of a boulder (no FAMILY_BOULDER count fact)"
        }
      ],
