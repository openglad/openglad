      "semantic": "A SPEC key press latches that key's ability (SHIFT read at the press, not later) and is a special press; releasing the active key while another SPEC key is still held promotes that key as a fresh press; releasing with nothing held clears the latch; a key already held before the belt saw it is not a press.",
      "arms": [
        {
          "when": "new press edge",
          "observable": "special_pressed true, belt_cast = byte of slot_index(key, shift at press)"
        },
        {
          "when": "active released, other held",
          "observable": "special_pressed true, latch moves to the other key"
        },
        {
          "when": "active released, none held",
          "observable": "latch cleared, belt_cast 0, special_held false"
        },
        {
          "when": "active still held, no edge",
          "observable": "special_pressed false, held true, same byte even if SHIFT changed"
        }
      ],
      "setting": "none",
      "status": "asserted",
