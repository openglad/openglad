      "function": "possess",
      "anchor": "if (&rider == &host || !is_living(rider) || !is_living(host))",
      "condition": "&rider==&host || !living; rider dead/hidden/dormant/linked; rider.real_team_num() != kNoTeam",
      "semantic": "POSSESS needs a free rider: a visible, awake, living walker that is not already riding, not charmed, and not the host itself; otherwise 'CANNOT POSSESS' and nothing changes.",
      "arms": [
        {
          "when": "rider is host / not living / dead / hidden / dormant / already linked / charmed",
          "observable": "{false,'CANNOT POSSESS'}; no link, rider visible, teams unchanged"
        },
        {
          "when": "valid rider",
          "observable": "continues"
        }
      ],
      "setting": "new-specials",
      "status": "partial",
      "tests": [
        {
          "file": "tests/unit/test_kit_possession.cpp",
          "test": "KitPossession.undead_seat_and_linked_hosts_refuse",
          "note": "rider==host, non-living rider and host, charmed rider, already-linked rider: reason and no writes"
        },
        {
          "file": "tests/unit/test_kit_possession.cpp",
          "test": "KitPossession.possess_moves_the_seat_tag_hides_the_rider_and_flips_the_host",
          "note": "valid rider continues"
        }
      ],
      "missing_arms": [
        "rider is host / not living / dead / hidden / dormant / already linked / charmed"
      ]
    },
