        {
          "when": "live and not dormant",
          "observable": "counted (units/roster/marker)"
        },
        {
          "when": "dead or dormant",
          "observable": "ignored: a team whose only units are dormant has units 0 and anchors at its marker (or is site-less)"
        }
      ],
      "setting": "none",
      "status": "partial",
      "tests": [
        {
          "file": "tests/unit/test_staged_rules.cpp",
          "test": "ClassicLineupTest.traded_units_become_a_fair_squad_at_their_centroid",
          "note": "live awake units counted: all 5 members within 48 px of their centroid (400,576)"
        },
        {
          "file": "tests/unit/test_staged_rules.cpp",
          "test": "ClassicLineupTest.fill_strong_spawns_a_solved_squad_on_a_marker_team",
          "note": "live marker counted: members within 48 px of it"
        }
      ],
      "missing_arms": [
        "dead or dormant"
      ]
    },
